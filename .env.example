PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=servicehub_db
DB_USER=postgres
DB_PASSWORD=postgres
# Or complete connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/servicehub_db

# JWT Configuration
JWT_SECRET=servicehub_jwt_super_secret_key_2026
JWT_EXPIRE=30d

# AI Configuration (Optional Gemini API key for external LLM)
GEMINI_API_KEY=your_gemini_api_key_here
